# Server-only configuration. Relative paths resolve from the project root.
DATABASE_PATH=./data/movies.sqlite
# Explicit local-only bypass. Production must use link; never publish local mode.
ACCESS_MODE=local
# Generate 32 random bytes as base64url; keep only in private production runtime.env.
ACCESS_LINK_SECRET=
# Comma-separated exact origins, including HTTPS ports. No trailing slash.
ACCESS_ALLOWED_ORIGINS=
# Optional until the integration subphases. Never use NEXT_PUBLIC_ for secrets.
# TMDB API v3 key; search and metadata use en-US. Keep the real value in .env.local.
TMDB_API_KEY=
# Server-only paid requests require an explicit CLI live command or UI confirmation.
OPENAI_API_KEY=
# Set explicitly for live analysis; initial intended choice: gpt-6.1-sol.
OPENAI_MODEL=

# Container deployment uses a separate private runtime.env outside this repository.
# Compose fixes DATABASE_PATH=/app/data/movies.sqlite; do not mount this local data folder.
