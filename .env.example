# Server-only configuration. Relative paths resolve from the project root.
DATABASE_PATH=./data/movies.sqlite
# Optional until the integration subphases. Never use NEXT_PUBLIC_ for secrets.
# TMDB API v3 key; search and metadata use en-US. Keep the real value in .env.local.
TMDB_API_KEY=
# Used only by an explicit taste:generate -- --live invocation.
OPENAI_API_KEY=
# Set explicitly for live analysis; initial intended choice: gpt-6.1-sol.
OPENAI_MODEL=
