{
  "name": "movie-recommender",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "db:check": "tsx scripts/db-check.ts",
    "test:db": "tsx --test scripts/db.test.ts scripts/schema.test.ts scripts/letterboxd.test.ts scripts/tmdb.test.ts scripts/foundation.test.ts scripts/taste.test.ts scripts/candidates.test.ts scripts/recommendations.test.ts scripts/recommendation-memory.test.ts scripts/movie-catalog.test.ts scripts/movie-watch.test.ts scripts/library.test.ts",
    "db:init": "tsx scripts/db-init.ts",
    "seed:letterboxd": "tsx scripts/seed-letterboxd.ts",
    "tmdb:enrich": "tsx scripts/tmdb-enrich.ts",
    "taste:generate": "tsx scripts/taste-generate.ts",
    "taste:show": "tsx scripts/taste-show.ts",
    "candidates:generate": "tsx scripts/candidates-generate.ts",
    "recommendations:rank": "tsx scripts/recommendations-rank.ts",
    "recommendations:record": "tsx scripts/recommendations-record.ts",
    "recommendations:history": "tsx scripts/recommendations-history.ts",
    "recommendations:reject": "tsx scripts/recommendations-reject.ts",
    "taste:status": "tsx scripts/taste-status.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
